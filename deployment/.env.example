# ==============================================================================
# LearnDynamicPro - Environment Configuration Template
# ==============================================================================
# Copy this file to .env before deploying to production:
#   cp deployment/.env.example deployment/.env
# ==============================================================================

# Application & Image Settings
IMAGE_TAG=latest
APP_PORT=8080

# Database Credentials
MSSQL_SA_PASSWORD=<CHANGE_ME_STRONG_SA_PASSWORD>

# JWT Authentication Secret (Must be >= 32 characters long)
JWT_SECRET=<CHANGE_ME_32_PLUS_CHARS_JWT_SECRET>
JWT_ISSUER=DynamicProLearn
JWT_AUDIENCE=DynamicProLearnClient
JWT_EXPIRY_MINUTES=60

# ERP SSO Secret (Shared exclusively with ERP LMSController; >= 32 chars)
ERP_SSO_SECRET=<CHANGE_ME_32_PLUS_CHARS_ERP_SSO_SECRET>
ERP_SSO_ISSUER=ERPSystemAPI
ERP_SSO_AUDIENCE=DynamicProLearn
ERP_SSO_MAX_LIFETIME_MINUTES=5
ALLOW_LEGACY_ERP_LOGIN=false

# Internal Service-to-Service AI Token (Must match AI Co-Pilot token)
# AI Co-Pilot Base URL (Internal container DNS)
AI_BASE_URL=http://lms_copilot_api:8000
AI_SERVICE_TOKEN=<CHANGE_ME_AI_SERVICE_TOKEN>

# AI Co-Pilot Webhook URL
AI_WEBHOOK_URL=http://lms_copilot_api:8000/v1/webhooks/lesson-updated
